<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="?attr/colorError" /><stroke android:width="2dp" android:color="?attr/colorOnError" /><corners android:radius="10dp" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="?attr/colorError" /><stroke android:width="2dp" android:color="?attr/colorOnError" /><corners android:radius="10dp" /></shape>
    </item>
    <item >
        <shape><solid android:color="?attr/colorError" /><corners android:radius="10dp" /></shape>
    </item>
</selector>
