<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:padding="16dp" android:background="@drawable/offline_card">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/offline_sync_device"
        android:textSize="18sp" android:textStyle="bold" android:textColor="@color/offline_text" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:text="@string/offline_sync_device_hint" android:textSize="12sp" android:textColor="@color/offline_secondary" />
    <TextView android:id="@+id/offline_sync_device_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:padding="10dp" android:background="@drawable/offline_button_secondary"
        android:textColor="@color/offline_accent" android:textSize="13sp" />
    <TextView android:id="@+id/offline_sync_found" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:layout_marginBottom="8dp" android:textColor="@color/offline_secondary" android:textSize="12sp" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <ListView android:id="@+id/offline_sync_devices" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:divider="@android:color/transparent" android:dividerHeight="8dp" android:listSelector="@android:color/transparent" />
        <TextView android:id="@+id/offline_sync_device_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="90dp" android:gravity="center" android:padding="16dp" android:text="@string/offline_sync_device_empty"
            android:textColor="@color/offline_secondary" android:textSize="13sp" />
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="end">
        <TextView android:id="@+id/offline_sync_device_cancel" android:layout_width="wrap_content" android:layout_height="44dp"
            android:minWidth="72dp" android:paddingHorizontal="16dp" android:gravity="center" android:text="@string/offline_cancel"
            android:background="@drawable/offline_button_secondary" android:textColor="@color/offline_text" android:focusable="true" />
        <TextView android:id="@+id/offline_sync_device_refresh" android:layout_width="wrap_content" android:layout_height="44dp"
            android:layout_marginStart="8dp" android:paddingHorizontal="16dp" android:gravity="center" android:text="@string/offline_sync_refresh"
            android:background="@drawable/offline_button_primary" android:textColor="#101B23" android:textStyle="bold" android:focusable="true" />
    </LinearLayout>
</LinearLayout>
