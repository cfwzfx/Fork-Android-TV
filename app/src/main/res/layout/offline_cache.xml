<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/offline_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/offline_background">
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/offline_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/offline_title"
                android:textColor="@color/offline_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/offline_subtitle"
                android:textColor="@color/offline_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/offline_settings_button" android:layout_width="44dp" android:layout_height="44dp"
            android:layout_marginStart="8dp" android:background="@drawable/offline_button_secondary"
            android:contentDescription="@string/offline_settings" android:src="@drawable/offline_settings"
            android:tint="@color/offline_text" android:padding="11dp" android:focusable="true" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/offline_back" android:layout_width="44dp" android:layout_height="44dp"
            android:layout_marginStart="8dp" android:background="@drawable/offline_button_secondary"
            android:contentDescription="@string/offline_back" android:src="@drawable/offline_back"
            android:tint="@color/offline_text" android:padding="11dp" android:focusable="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/offline_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/offline_card"
        android:padding="10dp"
        android:text="@string/offline_loading"
        android:textColor="@color/offline_secondary"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/offline_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="12dp" />

        <LinearLayout
            android:id="@+id/offline_empty_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:importantForAccessibility="no"
                android:src="@drawable/offline_download"
                android:tint="@color/offline_accent" />

            <TextView
                android:id="@+id/offline_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="8dp"
                android:text="@string/offline_loading"
                android:textColor="@color/offline_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>

</FrameLayout>
