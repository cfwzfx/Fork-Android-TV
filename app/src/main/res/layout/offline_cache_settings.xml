<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/offline_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/offline_background" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/offline_settings" android:textColor="@color/offline_text" android:textSize="20sp" android:textStyle="bold" />
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/offline_back" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/offline_button_secondary" android:contentDescription="@string/offline_back" android:src="@drawable/offline_back" android:tint="@color/offline_text" android:padding="11dp" android:focusable="true" />
    </LinearLayout>
    <LinearLayout android:id="@+id/offline_parallel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/offline_card" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:focusable="true" android:clickable="true">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/offline_parallel_downloads" android:textSize="16sp" android:textColor="@color/offline_text" />
        <TextView android:id="@+id/offline_parallel_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="@color/offline_accent" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/offline_parallel_help" android:textColor="@color/offline_secondary" android:textSize="13sp" />
    <TextView android:id="@+id/offline_cleanup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/offline_card" android:padding="16dp" android:text="@string/offline_cleanup" android:textColor="@color/offline_text" android:textSize="16sp" android:focusable="true" android:clickable="true" />
    <TextView android:id="@+id/offline_cleanup_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/offline_cleanup_help" android:textColor="@color/offline_secondary" android:textSize="13sp" android:accessibilityLiveRegion="polite" />
</LinearLayout>
